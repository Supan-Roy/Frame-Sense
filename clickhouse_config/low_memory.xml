<clickhouse>
    <!-- Restrict total server memory limit (~200MB) -->
    <max_server_memory_usage>209715200</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.3</max_server_memory_usage_to_ram_ratio>

    <!-- Shrink Mark Cache and Uncompressed Cache to 16MB -->
    <mark_cache_size>16777216</mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>

    <!-- Reduce thread pools -->
    <background_pool_size>2</background_pool_size>
    <background_schedule_pool_size>2</background_schedule_pool_size>
    <max_concurrent_queries>8</max_concurrent_queries>

    <!-- Disable internal system logs to prevent memory inflation over time -->
    <query_log><engine>ENGINE = Null</engine></query_log>
    <metric_log><engine>ENGINE = Null</engine></metric_log>
    <asynchronous_metric_log><engine>ENGINE = Null</engine></asynchronous_metric_log>
</clickhouse>
