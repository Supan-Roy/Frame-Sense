<clickhouse>
    <!-- Restrict total server memory limit to ~300MB -->
    <max_server_memory_usage>314572800</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.4</max_server_memory_usage_to_ram_ratio>

    <!-- Shrink Mark Cache from 5GB default to 32MB -->
    <mark_cache_size>33554432</mark_cache_size>

    <!-- Shrink Uncompressed Block Cache to 32MB -->
    <uncompressed_cache_size>33554432</uncompressed_cache_size>
</clickhouse>
