# ==============================================================================
# Frame Sense API Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini & Vertex AI Orchestration
# ------------------------------------------------------------------------------
# API key for Google AI Studio / Gemini 3.5 Models
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Vertex AI Google Cloud Project ID for Global Routing
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global
# Recommended Gemini models: gemini-3.5-flash-lite or gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. ClickHouse Cloud MCP (Model Context Protocol) Integration
# ------------------------------------------------------------------------------
# Hosted ClickHouse MCP Server Endpoint URL
CLICKHOUSE_MCP_ENDPOINT=https://mcp.clickhouse.cloud/mcp

# ClickHouse Cloud Access Token (Bearer Token for HTTP MCP requests)
CLICKHOUSE_CLOUD_ACCESS_TOKEN=your_clickhouse_cloud_access_token_here

# (Optional) Dynamic Token Rotation Secrets
CLICKHOUSE_CLOUD_REFRESH_TOKEN=your_clickhouse_cloud_refresh_token_here
CLICKHOUSE_CLOUD_SERVICE_ID=your_clickhouse_cloud_service_id_here
CLICKHOUSE_CLOUD_AUTH_URL=https://api.clickhouse.cloud/v1/auth/token

# ------------------------------------------------------------------------------
# 3. ClickHouse Database Direct Telemetry Credentials (Local or Cloud)
# ------------------------------------------------------------------------------
# Local Docker Defaults: host=localhost, port=8123, user=default, password=
# Cloud Defaults: host=<service_id>.<region>.clickhouse.cloud, port=8443, secure=true
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# ------------------------------------------------------------------------------
# 4. API Server Runtime Configuration
# ------------------------------------------------------------------------------
PORT=8001
ENVIRONMENT=development
